# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor — nunca use o prefixo NEXT_PUBLIC_ nestas duas.
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_WEBHOOK_SECRET=

# Gateway de pagamento (Asaas) — opcional. Sem ASAAS_API_KEY, o Portal do
# Associado usa o gateway simulado (nenhuma cobrança real é criada).
# Chave em Asaas > Integrações > Chave de API (o ambiente é detectado pelo
# próprio prefixo da chave: $aact_hmlg_ = sandbox, $aact_prod_ = produção).
ASAAS_API_KEY=
# Token que você mesmo escolhe ao cadastrar o webhook em Asaas > Integrações >
# Webhooks (evento "Cobranças", URL https://SEU_DOMINIO/api/webhooks/asaas).
# Precisa ser igual ao "authToken" configurado lá — nunca use a API key aqui.
ASAAS_WEBHOOK_TOKEN=
