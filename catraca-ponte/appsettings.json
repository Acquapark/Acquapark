{
  // "Catraca" usa a catraca de verdade (EasyInner.dll). "Simulador" lê os
  // códigos digitados no teclado — serve para testar a conexão com o sistema
  // sem a catraca ligada.
  "Modo": "Catraca",

  "Sistema": {
    // Endereço do Aqua Park Manager publicado (sem barra no final).
    "Url": "https://SEU_DOMINIO",
    // Mesmo valor de CATRACA_API_KEY configurado no servidor do sistema.
    "ChaveApi": "COLE_AQUI_A_CATRACA_API_KEY",
    "TimeoutMs": 8000
  },

  "Catraca": {
    // Número do Inner configurado no próprio equipamento (menu do Inner).
    "NumeroInner": 1,
    // 2 = TCP/IP porta fixa (padrão Topdata). 0 = serial/USB.
    "TipoConexao": 2,
    // Porta TCP (3570 é o padrão Topdata) ou número da COM na conexão serial.
    "Porta": 3570,
    // "Entrada", "EntradaInvertida", "Saida", "SaidaInvertida" ou "DoisSentidos".
    "SentidoLiberacao": "Entrada",
    // Os códigos do sistema têm 14 dígitos (com zeros à esquerda).
    "DigitosCodigo": 14,
    "TempoMensagemNegadoMs": 2500,
    // Tempo que o visor mostra "BEM VINDO" depois de liberar o giro.
    "TempoMensagemLiberadoMs": 3000,
    "IntervaloPingMs": 5000
  },

  "Mensagens": {
    // Visor do Inner: 2 linhas de 16 caracteres (32 no total).
    "Padrao": "  AQUA PARK     APROXIME O QR  ",
    "Liberado": "   BEM VINDO!",
    "Negado": " ACESSO NEGADO",
    "SemConexao": "  SEM CONEXAO   CHAME ATENDENTE"
  },

  // Valores numéricos passados às funções de configuração do EasyInner.
  // Os padrões seguem os exemplos da Topdata; confira no manual do SDK que
  // acompanha a sua versão da DLL e ajuste aqui se o seu leitor for outro.
  "Avancado": {
    "EnviarConfiguracao": true,
    "PadraoCartao": 1,
    "TipoLeitor": 0,
    // Modo da catraca (FuncaoAcionamento do SDK): 1 = entrada e saída
    // controladas, 6 = saída liberada, 7 = entrada liberada, 8 = liberada nos
    // dois sentidos. Em catraca instalada invertida, 6 e 7 trocam de lado.
    "FuncaoAcionamento1": 1,
    "TempoAcionamento1": 5,
    "FuncaoAcionamento2": 0,
    "TempoAcionamento2": 0,
    // 0 = desativado, 1 = só entrada, 2 = só saída, 3 = entrada e saída.
    // Com saída liberada (6), use 1; com entrada liberada (7), use 2.
    "OperacaoLeitor1": 1,
    "OperacaoLeitor2": 0,
    "FormaEntrada": 11,
    "TempoTeclado": 10,
    "PosicaoCursorTeclado": 17
  },

  // Leitor facial Hikvision (ex: DS-K1T673DX), na mesma rede do PC da ponte.
  // A ponte cadastra nele os associados com foto (busca no sistema a cada
  // IntervaloSincronizacaoMin minutos) e, quando ele reconhece alguém,
  // pergunta ao sistema se pode entrar - mesma regra do QR Code.
  "LeitorFacial": {
    "Habilitado": false,
    // IP fixo do leitor (menu do aparelho ou programa SADP da Hikvision).
    "Ip": "192.168.1.64",
    "Porta": 80,
    "UsarHttps": false,
    // Usuário/senha de administrador definidos na ativação do aparelho.
    "Usuario": "admin",
    "Senha": "COLE_AQUI_A_SENHA_DO_LEITOR",
    // "Catraca": a ponte libera o giro da catraca (leitor só na rede).
    // "ReleLeitor": o relé do leitor está ligado na catraca e a ponte manda o
    // leitor acioná-lo. Nesse caso o leitor NÃO pode abrir sozinho (veja o LEIA-ME).
    "Liberacao": "Catraca",
    "NumeroPorta": 1,
    "IntervaloSincronizacaoMin": 10,
    "IgnorarRepeticaoMs": 6000,
    // Subtipos de evento que contam como rosto reconhecido (75 = autenticação
    // facial aprovada). O log mostra os subtipos que chegam, se precisar ajustar.
    "SubEventosReconhecido": [ 75 ],
    "TimeoutMs": 10000
  }
}
